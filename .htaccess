# ShopHub E-Commerce Frontend - Cache Control Configuration
# Place this file in the root directory of your web server

# Enable mod_expires for caching control
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # Images: Cache for 1 year
    ExpiresByType image/jpeg                 "access plus 1 year"
    ExpiresByType image/gif                  "access plus 1 year"
    ExpiresByType image/png                  "access plus 1 year"
    ExpiresByType image/webp                 "access plus 1 year"
    ExpiresByType image/x-icon               "access plus 1 year"
    ExpiresByType image/svg+xml              "access plus 1 year"
    
    # Media: Cache for 1 year
    ExpiresByType audio/ogg                  "access plus 1 year"
    ExpiresByType video/mp4                  "access plus 1 year"
    ExpiresByType video/webm                 "access plus 1 year"
    
    # CSS and JavaScript: Cache for 30 days (allows for updates)
    ExpiresByType text/css                   "access plus 30 days"
    ExpiresByType application/javascript     "access plus 30 days"
    ExpiresByType text/javascript            "access plus 30 days"
    
    # Fonts: Cache for 1 year (rarely change)
    ExpiresByType font/ttf                   "access plus 1 year"
    ExpiresByType font/otf                   "access plus 1 year"
    ExpiresByType font/woff                  "access plus 1 year"
    ExpiresByType font/woff2                 "access plus 1 year"
    ExpiresByType application/font-woff      "access plus 1 year"
    
    # HTML: Cache for 1 day (frequently updated)
    ExpiresByType text/html                  "access plus 1 day"
    
    # JSON/API: No cache (always fresh)
    ExpiresByType application/json           "access immediate"
</IfModule>

# Enable mod_headers for Cache-Control headers
<IfModule mod_headers.c>
    # Images: Long-term caching (1 year)
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|ico|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set Expires "Wed, 21 Oct 2027 07:28:00 GMT"
    </FilesMatch>
    
    # CSS and JS: Medium-term caching (30 days)
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
        Header set Expires "Wed, 15 Mar 2026 07:28:00 GMT"
    </FilesMatch>
    
    # Minified assets: Long-term (1 year) - versioned
    <FilesMatch "\.(min\.js|min\.css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Fonts: Long-term caching (1 year)
    <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
        Header set Expires "Wed, 21 Oct 2027 07:28:00 GMT"
    </FilesMatch>
    
    # HTML pages: Short-term caching (1 day)
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=86400, must-revalidate"
        Header set Expires "Sat, 14 Feb 2026 07:28:00 GMT"
    </FilesMatch>
    
    # JSON/API responses: No caching
    <FilesMatch "\.json$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# Enable gzip compression for text-based files
<IfModule mod_deflate.c>
    # Compress HTML, CSS, JavaScript
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    
    # Compress SVG
    AddOutputFilterByType DEFLATE image/svg+xml
    
    # Don't compress already compressed files
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|rar|zip|exe|flv|mov|wma|wmv|webp|webm|mp4)$ no-gzip dont-vary
</IfModule>

# Set ETag for proper cache validation
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Remove ETags for caching across servers
    # Uncomment if using load balancing
    # Header unset ETag
    # FileETag None
</IfModule>

# Set proper MIME types
<IfModule mod_mime.c>
    AddType font/woff2                      woff2
    AddType font/woff                       woff
    AddCharset utf-8 .js
    AddCharset utf-8 .css
    AddCharset utf-8 .json
</IfModule>

# Security headers (optional)
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Enable XSS protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # Clickjacking protection
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Note: This file requires the following Apache modules to be enabled:
# - mod_expires
# - mod_headers
# - mod_deflate
# - mod_rewrite (for security headers)

# To enable these modules on your server:
# sudo a2enmod expires
# sudo a2enmod headers
# sudo a2enmod deflate
# sudo a2enmod rewrite
# sudo systemctl restart apache2
